          "name": "Upload an asset",
          "request": {
            "name": "Upload an asset",
            "description": {
              "content": "Upload a new asset (image, video, audio, or 3D model). Accepts multipart/form-data with a file and optional description. Maximum file size: 75MB.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "assets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The file to upload (JPEG, PNG, WebP, HEIC, MP4, MOV, WebM, GLB, WAV, MP3). Maximum size: 75MB."
                },
                {
                  "key": "description",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional description for the asset"
                }
              ]
            }
